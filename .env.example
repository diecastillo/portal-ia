# Copia este archivo a ".env" EN EL SERVIDOR y rellénalo ahí.
# El archivo ".env" nunca debe subirse a GitHub (ya está en .gitignore).

# Datos SMTP para enviar los correos con las credenciales
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_cuenta@gmail.com
SMTP_APP_PASSWORD=pega_aqui_tu_contraseña_de_aplicacion

# Puerto del backend (nginx hará de proxy hacia aquí)
PORT=4001

# Solo si el portal se sirve desde OTRO dominio (para el CORS). Si no, déjalo vacío.
PORTAL_ORIGIN=
